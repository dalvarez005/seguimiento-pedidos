# Copiar a .env y completar. Sin DATABASE_URL se usa SQLite local (pedidos.db).
DATABASE_URL=postgresql+psycopg://usuario:clave@host.docker.internal:5432/pedidos
# Opcional: funciones de IA. Se prueban en el orden de AI_ORDER; si uno falla
# (sin saldo, saturado, caído o lento) la solicitud pasa al siguiente.
# Los modelos aceptan varios separados por coma (cada uno es otro respaldo).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_ORDER=gemini,anthropic
AI_TIMEOUT=15
APP_PORT=5210
